# ---- Data (large; released separately via cloud disk) ----
# Keep the directory skeleton (.gitkeep) and processing notebooks, drop tensors.
*.npz
*.npy
*.h5
*.csv

# ---- Run artifacts ----
log/
run_logs/
nohup.out
*.log

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ---- OS / editor ----
.DS_Store
.vscode/
.idea/

# ---- Keep placeholders ----
!**/.gitkeep

# Released aggregate graph counts are small, editable plotting inputs.
!figures/evost/graph/graph_statistics.csv
outputs/
artifacts/

# annual-benchmark results are part of the release (results/evost/annual/README.md)
!results/evost/annual/*.csv

# case-study values behind Figure 7 (results/evost/case_study/README.md)
!results/evost/case_study/*.csv
